# Copy to .env and replace every REPLACE_ME before ANY deploy, shared or not.
# These are published in the repository: anyone can read them. The API
# REFUSES TO START on a placeholder API_KEY (core/startup_checks.py).
# .env is gitignored; this file is the tracked contract of required variables.

# --- MinIO (object storage) ---
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET="knowall"

# --- Qdrant (vector database) ---
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_COLLECTION="knowall_collection"
# Required: Qdrant ships with no auth. Compose refuses to start without it.
QDRANT_API_KEY=REPLACE_ME_BEFORE_ANY_DEPLOY

# --- Ollama (local LLM + embeddings) ---
OLLAMA_API_URL=http://ollama:11434/api/

# --- OpenAI (optional remote backends) ---
OPENAI_API_KEY=
USE_OPENAI_LLM=false
USE_OPENAI_EMBEDDING=false

# --- Embedding model identity (finding #24) ---
# Ollama cannot pull by digest, so drift is caught by assertion instead.
# Bare hex as reported by `GET /api/tags` — NO sha256: prefix.
# Unset  = loud warning at every startup (drift undetectable).
# Set    = hard fail at API startup, worker startup and the eval head.
# Read the current value with:
#   docker compose exec api python -c "from core.config import get_settings; \n#     from core.model_identity import fetch_ollama_digest as f; s=get_settings(); \n#     print(f(s, s.embed_model))"
# Finding #24 extended to the GENERATOR. Same moving-tag exposure, different
# blast radius: embedding drift invalidates stored vectors; generation drift
# invalidates every measured claim about abstention, grounding and
# instruction-following. Read it from `ollama list` / /api/tags.
EXPECTED_LLM_MODEL_DIGEST=

EXPECTED_EMBED_MODEL_DIGEST=

# --- Redis (durable ingestion queue + job status) ---
REDIS_URL=redis://redis:6379/0

# --- Web frontend ---
BACKEND_URL=http://api:8000

# --- API authentication ---
# API_KEY       = full access; the proxy uses it for write routes only.
# API_QUERY_KEY = read-only scope; the proxy uses it for query/list/stats.
# API_QUERY_KEYS= backend's accepted read-only list (must contain API_QUERY_KEY).
API_KEY=REPLACE_ME_BEFORE_ANY_DEPLOY
API_QUERY_KEY=REPLACE_ME_BEFORE_ANY_DEPLOY
API_QUERY_KEYS=REPLACE_ME_BEFORE_ANY_DEPLOY

# Browser session auth (web tier only). SESSION_SECRET must be >=32 chars.
SESSION_SECRET=REPLACE_ME_BEFORE_ANY_DEPLOY
AUTH_PASSWORD=REPLACE_ME_BEFORE_ANY_DEPLOY
AUTH_REQUIRED=true
# Set true once TLS terminates in front of the web tier (browsers drop
# `secure` cookies over plain http://).
COOKIE_SECURE=false

# Concurrency + rate limiting
RATE_LIMIT_PER_MINUTE=30
# MEASURED against what actually binds, which is MEMORY, not the timeout.
#
# Finding #37 is RETRACTED. It derived this ceiling from llm_read_timeout alone
# and never asked what else could run out first. Every value it produced is
# unfounded, including the 4 that shipped here.
#
# For llama3.2:1b, api container at a 5 GiB limit:
#     fixed resident            1.62 GiB
#     concurrency 1  settled    3.87 GiB   (77% of the limit)
#     concurrency 2  settled    4.88 GiB   (98% — survivable, no headroom)
#     concurrency 3  projected  5.88 GiB   (does not fit)
#
# 1 is what fits with real headroom. At 3 GiB the container reached 99.6% at
# concurrency 1 and restarted under load.
#
# THIS MAKES THE INCUMBENT EFFECTIVELY SINGLE-USER. That is a product decision,
# not a config value: if one concurrent user is unacceptable, the answer is the
# GENERATOR CHANGE, not this number. See docs/HANDOFF.md open questions.
#
# core/admission_limits.py validates this against the container's real cgroup
# limit at startup and refuses to boot if it does not fit.
MAX_CONCURRENT_QUERIES=1

# Finding #28 - semantic-drift guard on query rewrite. A rewrite whose cosine
# similarity to the original question falls below this is discarded and the
# original is used. A gross-drift safety net, not a quality knob.
REWRITE_MIN_SIMILARITY=0.55

# --- retrieval: abstention vs relevance (finding #27 / P-2 candidate C3) ------
# One number used to do both jobs and was bad at the one that mattered.
#
# ABSTENTION - "did retrieval return anything coherent at all?" A cross-encoder
# sigmoid below 0.01 is a logit near -4.6: the model confidently rejects even its
# own best candidate. Principled, tied to the model's confidence semantics, NOT
# fitted to a corpus. This is not a relevance knob and must not be tuned as one.
ABSTENTION_SCORE_FLOOR=0.01
#
# RELEVANCE - optional per-chunk cut, OFF by default. At 0.25 this discarded
# correctly-ranked FIRST-PLACE answers whose absolute score was low because they
# were tables, lists or OCR text - chunk shape moves that score as much as
# relevance does. Ordering is the reranker's job; RERANK_TOP_N bounds the count.
# Above 0 restores the pre-C3 behaviour.
RERANK_SCORE_FLOOR=0.0

# Finding #32 / P-3 candidate D5 - malformed-generation guard. Minimum
# SUBSTANTIVE characters (citation markers stripped) for a generation to count
# as an answer. The model sometimes emits "[1] [1][3]" and nothing else, which
# passes every other check and reaches the user as an empty bubble.
# REVERSIBLE: 0 disables the guard and reproduces pre-2.4 behaviour exactly.
MIN_ANSWER_CHARS=20

# Finding #5 / P-3 candidates D1+D6 - quote-backed grounding. The generator must
# copy a supporting sentence out of each passage it cites; the quote is then
# checked to occur in that passage by string comparison, with no model judgement
# in the check.
# DOCUMENTED GAP: catches claims with no textual basis in the cited passage.
# Does NOT catch a claim that quotes truthfully and reasons wrongly from it.
# REVERSIBLE: false drops both the prompt rule and the check.
# SHIPS OFF: measured on llama3.2:1b, rule 5 dropped answered questions
# from 13/15 to 2/15. A generation regression, not a grounding mechanism.
REQUIRE_SUPPORT_QUOTES=false

# Phase 2.3 - prompt-injection containment. Retrieved passages are untrusted
# input sharing a prompt with the grounding rules, so they are fenced and
# fence/header/role/abstention-shaped text is stripped from the body. A fence a
# poisoned chunk can close is decoration, which is why both halves exist.
# REVERSIBLE: false reproduces pre-2.3 assembly byte-for-byte.
CONTAIN_UNTRUSTED_PASSAGES=true

# Copy to .env and replace every *-change-me value before any shared deploy.
# .env is gitignored; this file is the tracked contract of required variables.

# --- MinIO (object storage) ---
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET="knowall"

# --- Qdrant (vector database) ---
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_COLLECTION="knowall_collection"
# Required: Qdrant ships with no auth. Compose refuses to start without it.
QDRANT_API_KEY=knowall-qdrant-key-change-me

# --- Ollama (local LLM + embeddings) ---
OLLAMA_API_URL=http://ollama:11434/api/

# --- OpenAI (optional remote backends) ---
OPENAI_API_KEY=
USE_OPENAI_LLM=false
USE_OPENAI_EMBEDDING=false

# --- Embedding model identity (finding #24) ---
# Ollama cannot pull by digest, so drift is caught by assertion instead.
# Bare hex as reported by `GET /api/tags` — NO sha256: prefix.
# Unset  = loud warning at every startup (drift undetectable).
# Set    = hard fail at API startup, worker startup and the eval head.
# Read the current value with:
#   docker compose exec api python -c "from core.config import get_settings; \n#     from core.model_identity import fetch_ollama_digest as f; s=get_settings(); \n#     print(f(s, s.embed_model))"
EXPECTED_EMBED_MODEL_DIGEST=

# --- Redis (durable ingestion queue + job status) ---
REDIS_URL=redis://redis:6379/0

# --- Web frontend ---
BACKEND_URL=http://api:8000

# --- API authentication ---
# API_KEY       = full access; the proxy uses it for write routes only.
# API_QUERY_KEY = read-only scope; the proxy uses it for query/list/stats.
# API_QUERY_KEYS= backend's accepted read-only list (must contain API_QUERY_KEY).
API_KEY=knowall-dev-key-change-me
API_QUERY_KEY=knowall-readonly-key-change-me
API_QUERY_KEYS=knowall-readonly-key-change-me

# Browser session auth (web tier only). SESSION_SECRET must be >=32 chars.
SESSION_SECRET=knowall-dev-session-secret-change-me-32chars
AUTH_PASSWORD=knowall-dev-password-change-me
AUTH_REQUIRED=true
# Set true once TLS terminates in front of the web tier (browsers drop
# `secure` cookies over plain http://).
COOKIE_SECURE=false

# Concurrency + rate limiting
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_QUERIES=20

# Finding #28 - semantic-drift guard on query rewrite. A rewrite whose cosine
# similarity to the original question falls below this is discarded and the
# original is used. A gross-drift safety net, not a quality knob.
REWRITE_MIN_SIMILARITY=0.55
